{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusion.local/contracts/evidence.schema.json",
  "title": "Exported owned verification record - not import authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "spec",
    "environment",
    "artifact_hash",
    "suite_hash",
    "spec_hash",
    "environment_hash",
    "report_hash",
    "stderr_hash",
    "tool_version",
    "started_at",
    "finished_at",
    "exit_code",
    "executed",
    "stopped",
    "truncated",
    "interrupted",
    "input_changed"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "args",
        "suite_paths",
        "rules",
        "timeout_ns"
      ],
      "properties": {
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "sha256",
            "version",
            "version_args"
          ],
          "properties": {
            "executable": {
              "type": "string",
              "pattern": "^/",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "version_args": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "maxLength": 8192
              },
              "minItems": 1
            }
          }
        },
        "args": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "suite_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_tests",
            "allow_zero",
            "allow_skipped"
          ],
          "properties": {
            "min_tests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "allow_zero": {
              "type": "boolean"
            },
            "allow_skipped": {
              "type": "boolean"
            }
          }
        },
        "timeout_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000000000
        }
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "suite_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "report_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stderr_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "exit_code": {
      "type": "integer"
    },
    "executed": {
      "type": "boolean"
    },
    "stopped": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    },
    "interrupted": {
      "type": "boolean"
    },
    "input_changed": {
      "type": "boolean"
    }
  }
}
