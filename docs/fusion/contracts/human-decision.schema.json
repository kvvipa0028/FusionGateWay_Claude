{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fusion:human-acceptance:v1",
  "title": "Historical explicit operator acceptance decision v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "text_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tree_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "design_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acceptance_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "action": {
      "enum": [
        "accept",
        "return"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "authority": {
      "const": "management"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "version",
    "task_id",
    "plan_revision",
    "generation",
    "run_id",
    "text_hash",
    "tree_hash",
    "spec_hash",
    "design_hash",
    "acceptance_hash",
    "action",
    "reason",
    "authority",
    "at"
  ],
  "additionalProperties": false
}
